# Copie este arquivo para `.env` e preencha. O instalador faz isso sozinho —
# isto aqui é para quem quiser conferir ou ajustar depois.
#
# IMPORTANTE: salve como UTF-8 SEM BOM. O Bloco de Notas do Windows salva COM BOM,
# e medimos o efeito: a primeira chave do arquivo vira inválida e some sem dar erro.
# Use o VS Code, ou rode o instalador de novo.

# Sua chave da API do Gemini. Grátis em https://aistudio.google.com/apikey
# Sem ela: a captura e a busca funcionam; extração de CRM e transcrição de áudio não.
GEMINI_API_KEY=

# Onde fica o seu segundo cérebro (vault do Obsidian).
# Criado por `node bin/criar-vault.js`. Padrão: <sua pasta de usuário>/AssessorVault
PUNK_RECORDS=

# Como você aparece nas buscas sobre as suas próprias mensagens.
ASSESSOR_DONO=Eu

# Onde o indexador acha o banco de mensagens. Padrão: ./data/assessor.db
ASSESSOR_DB=

# Porta do painel. O app só escuta em 127.0.0.1 — ninguém de fora alcança.
ASSESSOR_PORT=8787

# --- opcionais ---

# Forçar um motor de modelo: `api` (Gemini pela internet) ou `agy` (CLI do Orca).
# Em branco, escolhe sozinho: com GEMINI_API_KEY usa a API, sem ela tenta o agy.
# ASSESSOR_LLM=

# Onde o Ollama está servindo os embeddings da busca semântica.
# OLLAMA_HOST=http://localhost:11434

# Modelo de embeddings. Trocar exige reconstruir o índice: `npm run indexar`.
# BRAIN_EMBED_MODEL=bge-m3
