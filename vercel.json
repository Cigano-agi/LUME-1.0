{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel-site.mjs",
  "outputDirectory": "site-dist",
  "cleanUrls": true,
  "crons": [{"path":"/api/v1/central/retencao","schedule":"0 5 * * *"}],
  "rewrites": [
    {"source": "/api/v1/instalacoes/registrar", "destination": "/api/central?action=registrar"},
    {"source": "/api/v1/instalacoes/pulso", "destination": "/api/central?action=pulso"},
    {"source": "/api/v1/feedback", "destination": "/api/central?action=feedback"},
    {"source": "/api/v1/central/saude", "destination": "/api/central?action=saude"},
    {"source": "/api/v1/central/retencao", "destination": "/api/central?action=retencao"},
    {"source": "/api/v1/admin/sessao", "destination": "/api/central?action=sessao"},
    {"source": "/api/v1/admin/instalacoes", "destination": "/api/central?action=listar"},
    {"source": "/api/v1/admin/feedback", "destination": "/api/central?action=listar-feedback"},
    {"source": "/api/v1/admin/feedback/:id/revisar", "destination": "/api/central?action=revisar-feedback&id=:id"},
    {"source": "/api/v1/admin/feedback/:id/excluir", "destination": "/api/central?action=excluir-feedback&id=:id"},
    {"source": "/api/v1/admin/convites", "destination": "/api/central?action=convite"},
    {"source": "/api/v1/admin/convites/:id/revogar", "destination": "/api/central?action=revogar-convite&id=:id"},
    {"source": "/api/v1/admin/instalacoes/:id/revogar", "destination": "/api/central?action=revogar&id=:id"}
  ],
  "redirects": [
    {
      "source": "/releases/:channel/:file",
      "destination": "https://xtzcnwvizldelcss.public.blob.vercel-storage.com/releases/:channel/:file",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
